<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The window background shows before Compose draws; keep it close to the app surface color
         so launch does not flash white in dark mode. -->
    <style name="Theme.Flownics" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/launch_background</item>
    </style>
</resources>
