    <!-- Exercise: fill in -->
    <string name="ai_fill_button">Fill in with AI</string>
    <string name="ai_fill_title">AI details for “%1$s”</string>
    <string name="ai_fill_intro">The AI suggests the category, the muscles it works, coaching cues and more, from the name and what you\'ve entered. You choose what to keep, and nothing is saved until you save the exercise.</string>
    <string name="ai_fill_hint">Describe the exercise (optional): how it\'s done, the setup, what it\'s for. The more you tell, the closer the result.</string>
    <string name="ai_fill_search">Search the web for sources</string>
    <string name="ai_fill_search_hint">More reliable muscles, with links you can check. Slower and costs a little more.</string>
