    <string name="settings_ai_chat">The coach</string>
    <string name="settings_ai_chat_hint">Talk with the coach about your training</string>
    <string name="ai_settings_title">AI assistant</string>
    <string name="ai_settings_intro">Flownics can use AI to fill in exercises, review workouts, suggest variations and answer questions. It uses your own key, and nothing is sent until you press an AI button.</string>
    <string name="ai_settings_provider">Provider</string>
    <string name="ai_terms_gemini">On Google\'s free tier, Google may use what you send to improve its products. On a paid (billing-enabled) key it does not. See Google\'s Gemini API terms.</string>
    <string name="ai_terms_claude">Claude is paid per use. See Anthropic\'s terms for how API data is handled.</string>
    <string name="ai_settings_key">%1$s key</string>
    <string name="ai_key_saved">Key saved (%1$s)</string>
    <string name="ai_key_none">No key yet</string>
    <string name="ai_key_unreadable">A key was saved but can\'t be read on this device any more (for example after restoring onto a new phone). Enter it again.</string>
    <string name="ai_key_storage">Stored encrypted on this phone only. It is never included in backups or exports.</string>
    <string name="ai_key_add">Add key</string>
    <string name="ai_key_replace">Replace key</string>
    <string name="ai_key_remove">Remove</string>
