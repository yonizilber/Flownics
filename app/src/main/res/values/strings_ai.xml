    <string name="ai_key_field">API key</string>
    <string name="ai_key_notice">When you press an AI button, what that feature needs (for example the exercise or workout on screen, or your recent training without notes) is sent to %1$s with your key, and billed to you. Nothing is sent in the background.</string>
    <string name="ai_key_understood">I understand</string>
