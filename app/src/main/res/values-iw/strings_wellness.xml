    <string name="wellness_settings_intro">עם אותו מפתח, כל סנכרון מביא גם שינה (עם השלבים), HRV לילי, דופק מנוחה, Body Battery, סטרס, צעדים ו-VO2max. התשובות של גרמין נשמרות בטלפון כמו שהגיעו, והימים נקראים מהן.</string>
    <string name="wellness_history">כמה זמן אחורה</string>
    <string name="wellness_history_days">%1$d ימים</string>
    <string name="wellness_history_hint">בערך שלוש בקשות ליום בפעם הראשונה, במרווחים קטנים; היסטוריה ארוכה לוקחת כמה דקות, ונמשכת על פני כמה סנכרונים אם גרמין מבקשת להאט.</string>
    <string name="wellness_missing_fields">חיפשתי ולא מצאתי בתשובה האחרונה של גרמין (אפשר לראות בסייר הנתונים): %1$s</string>
