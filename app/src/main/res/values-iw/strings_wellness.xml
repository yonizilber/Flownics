    <string name="wellness_short">שינה</string>
    <string name="wellness_empty">עדיין אין נתוני שינה והתאוששות. הם מגיעים מגרמין עם המפתח האישי שלך, בכל סנכרון.</string>
    <string name="wellness_days">יום אחרי יום</string>
    <string name="wellness_source_note">מגרמין, כפי שהיא מחשבת אותם מהשעון. שלבי השינה מחושבים מתנועה ודופק; ציון השינה ו-Body Battery הם הערכות של גרמין עצמה (של Firstbeat), והנוסחאות שלהן לא פורסמו.</string>
    <string name="wellness_hypnogram_caption">כל פס הוא קטע של הלילה בשלב אחד, והשורה שלו אומרת איזה: ער למעלה, שינה עמוקה למטה. הזמן רץ משמאל לימין, מההירדמות עד היקיצה.</string>
    <string name="wellness_hypnogram_description">שלבי שינה מ-%1$s עד %2$s</string>
    <string name="wellness_stages_unconfirmed">ציר השלבים לא מסתכם לסכומים של גרמין לכל שלב, ולכן ייתכן ששמות השלבים נקראו כאן לא נכון. הסכומים למטה הם של גרמין.</string>
    <string name="wellness_no_timeline">גרמין נתנה את הסכומים של הלילה הזה, בלי ציר זמן.</string>
